msgid "Speed: %s"
msgstr "Velocità: %s"

#: src/menu_princ.c:50
msgid "The default speed."
msgstr "La velocità di base."

#: src/menu_princ.c:53
msgid ""
"In the turbo mode, everything goes twice as highter\n"
" and twice as faster."
msgstr "Nella modalità turbo, velocità e altezza raddoppiano."

#: src/menu_princ.c:56
msgid ""
"In the sprint mode, everything goes faster and highter\n"
" for each bounce."
msgstr ""
"Nella modalità veloce, velocità e altezza aumentano\n"
"ad ogni ribalzo."

#: src/menu_princ.c:59
msgid "In the fury mode, the speed is increased for each bounce."
msgstr "Nella modalità furia, la velocità aumenta ad ogni rimbalzo."

