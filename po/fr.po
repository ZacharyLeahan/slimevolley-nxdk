#: src/menu_jeu.c:218
msgid "Start the game with the specified parameters"
msgstr "Démarre le jeu avec les paramètres spécifiés"

#: src/menu_jeu.c:222
msgid ""
"This player will be controlled from the keyboard.\n"
"You can change the key configurations in the Options menu."
msgstr ""
"Ce joueur sera contrôlé par le clavier.\n"
"La configuration des touches peut être changée dans le menu Options."

#: src/menu_jeu.c:226
msgid "This player will be controlled by the computer."
msgstr "Ce joueur sera contrôlé par l'ordinateur."

#: src/menu_jeu.c:229
msgid ""
"This player will be controlled by a remote computer on local network.\n"
"You will need to allow connections to your computer on port 2222."
msgstr ""
"Ce joueur sera contrôlé par un ordinateur distant sur le réseau.\n"
"Le serveur devra accepter les connexions sur le port 2222."

#: src/menu_options.c:37
msgid "Fullscreen: Enabled"
msgstr "Plein écran : Activé"

#: src/menu_options.c:39
msgid "Fullscreen: Disabled"
msgstr "Plein écran : Désactivé"

#: src/menu_options.c:52
msgid "[Audio unavailable]"
msgstr "[Audio indisponible]"

#: src/menu_options.c:54
msgid "Sounds: Disabled"
msgstr "Sons : Désactivés"

#: src/menu_options.c:56
msgid "Sounds: Enabled"
msgstr "Sons : Activés"

#: src/menu_options.c:66
msgid "Score display: Enabled"
msgstr "Affichage du score : Act."

#: src/menu_options.c:68
msgid "Score display: Disabled"
msgstr "Affichage du score : Dés."

#: src/menu_options.c:78
msgid "FPS counter: Enabled"
msgstr "Compteur d'IPS : Act."

#: src/menu_options.c:80
msgid "FPS counter: Disabled"
msgstr "Compteur d'IPS : Dés."

#: src/menu_options.c:89
#, c-format
msgid "Theme: %s"
msgstr "Thème : %s"

#: src/menu_options.c:99
msgid "If enabled, the current score will be shown permanently."
msgstr "Si activé, le score sera affiché en permanence."

#: src/menu_options.c:104
msgid "Set keys"
msgstr "Définir les touches"

#: src/menu_options.c:104
msgid "Define game key controls."
msgstr "Configure les contrôles clavier."

#: src/menu_options.c:114
msgid "The theme change the menu and game look."
msgstr "Le thème change l'apparence du menu et du jeu."

#: src/menu_princ.c:33
msgid "normal"
msgstr "normale"

#: src/menu_princ.c:33
msgid "turbo"
msgstr "turbo"

#: src/menu_princ.c:33
msgid "sprint"
msgstr "sprint"

#: src/menu_princ.c:33
msgid "fury"
msgstr "furie"

#: src/menu_princ.c:35
#, c-format
msgid "Speed: %s"
msgstr "Vitesse : %s"

#: src/menu_princ.c:50
msgid "The default speed."
msgstr "La vitesse par défaut."

#: src/menu_princ.c:53
msgid ""
"In the turbo mode, everything goes twice as highter\n"
" and twice as faster."
msgstr ""
"Dans le mode turbo, tout va deux fois plus haut\n"
" et deux fois plus vite."

#: src/menu_princ.c:56
msgid ""
"In the sprint mode, everything goes faster and highter\n"
" for each bounce."
msgstr ""
"Dans le mode sprint, tout va plus vite et plus haut\n"
" à chaque rebond."

#: src/menu_princ.c:59
msgid "In the fury mode, the speed is increased for each bounce."
msgstr "Dans le mode furie, la vitesse augmente à chaque rebond."

#: src/menu_princ.c:69
#, c-format
msgid "Balls: %d"
msgstr "Balles : %d"

#: src/menu_princ.c:84
msgid "Play…"
msgstr "Jouer…"

#: src/menu_princ.c:84
msgid "Starts a new game."
msgstr "Démarre un nouveau jeu."

#: src/menu_princ.c:87
msgid "Connect to server…"
msgstr "Connexion distante…"

#: src/menu_princ.c:87
msgid "Connect to a distant server."
msgstr "Se connecte à un serveur distant sur le réseau."

#: src/menu_princ.c:92
msgid "Choose the number of balls."
msgstr "Choix du nombre de balles."

#: src/menu_princ.c:93
msgid "Options…"
msgstr "Options…"

#: src/menu_princ.c:93
msgid "Configure sound, keys, screen and theme."
msgstr "Configurer le son, les touches de contrôle, l'écran et le thème."

#: src/menu_princ.c:94
msgid "Credits"
msgstr "Crédits"

#: src/menu_princ.c:94
msgid "Who made this game?"
msgstr "Qui a fait ce jeu ?"

#: src/menu_princ.c:97
msgid "Quit"
msgstr "Quitter"

#: src/reseau.c:86 src/reseau.c:147
#, c-format
msgid "Connected: %d/%d"
msgstr "Connecté(s) : %d/%d"

#: src/reseau.c:87
msgid "Waiting for remote players..."
msgstr "Attente de joueurs distants..."

#: src/reseau.c:87 src/reseau.c:278 src/reseau.c:302
msgid "Press Escape to cancel."
msgstr "Tapez Echap pour annuler."

#: src/reseau.c:148
msgid "Get ready..."
msgstr "Prêt..."

#: src/reseau.c:262
msgid "Name resolving error."
msgstr "Erreur de résolution de nom."

#: src/reseau.c:262
msgid "Please check the hostname you provided."
msgstr "Veuillez vérifier le nom d'hôte que vous avez fourni."

#: src/reseau.c:278
msgid "Connecting to server..."
msgstr "Connexion au serveur..."

#: src/reseau.c:297
#, c-format
msgid "You will be the left player #%d."
msgstr "Vous serez le joueur de gauche n° %d."

#: src/reseau.c:299
#, c-format
msgid "You will be the right player #%d."
msgstr "Vous serez le joueur de droite n° %d."

#: src/reseau.c:302
msgid "Connected. Waiting for server..."
msgstr "Connecté. Attente du serveur..."

